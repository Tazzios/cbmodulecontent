{
    "name": "tazzios/cbmodulecontent",
    "description": "Joomla package for Community Builder: list module, content plugin and shared library",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require-dev": {
        "php": ">=8.1",
        "ext-pdo_sqlite": "*",
        "joomla/database": "^3.0 || ^4.0",
        "joomla/event": "^3.0 || ^4.0",
        "joomla/filter": "^3.0 || ^4.0",
        "joomla/registry": "^3.0 || ^4.0",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload-dev": {
        "psr-4": {
            "Tazzios\\Library\\CbListHelper\\": "src/lib_cblisthelper/src/",
            "Tazzios\\Module\\CbList\\Site\\": "src/mod_cblistmodule/src/",
            "Tazzios\\Plugin\\Content\\Cbprofile\\": "src/plg_content_cbprofile/src/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "phpcs": "phpcs"
    }
}
