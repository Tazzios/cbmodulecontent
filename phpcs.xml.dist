<?xml version="1.0"?>
<ruleset name="CB module and content">
    <description>PSR-12, as Joomla itself uses.</description>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>
    <file>package</file>
    <file>src</file>
    <file>tests</file>

    <rule ref="PSR12"/>

    <!-- Long lines in HTML and in test data are easier to read than broken ones. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>*/tmpl/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
        <properties>
            <property name="lineLimit" value="160"/>
            <property name="absoluteLineLimit" value="180"/>
        </properties>
    </rule>

    <!-- Stubs put several small Joomla classes in one file, tests and layouts have no namespace. -->
    <rule ref="PSR1.Classes.ClassDeclaration">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR2.Methods.MethodDeclaration.Underscore">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="PSR12.Files.FileHeader">
        <exclude-pattern>tests/*</exclude-pattern>
        <exclude-pattern>*/tmpl/*</exclude-pattern>
    </rule>
</ruleset>
