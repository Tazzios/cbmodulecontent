<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_CBLISTMODULE</name>
	<author>Tazzios (original Magnus Hasselquist https://github.com/magnushasselquist/hqcblistmodule)</author>
	<authorUrl>https://github.com/Tazzios</authorUrl>
	<creationDate>November 2026</creationDate>
	<copyright>(C) 2014 Magnus Hasselquist, (C) 2021 Tazzios</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>5.0.1</version>
	<description>MOD_CBLISTMODULE_XML_DESCRIPTION</description>
	<namespace path="src">Tazzios\Module\Cblistmodule</namespace>
	<files>
		<folder module="mod_cblistmodule">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="listid"
					type="sql"
					default=""
					label="MOD_CBLISTMODULE_FIELD_LISTID"
					key_field="listid"
					value_field="title"
					query="SELECT listid, title FROM #__comprofiler_lists WHERE published = 1"
				/>
				<field
					name="user-limit"
					type="number"
					min="0"
					filter="integer"
					default="10"
					label="MOD_CBLISTMODULE_FIELD_LIMIT"
					description="MOD_CBLISTMODULE_FIELD_LIMIT_DESC"
				/>
				<field
					name="orderby"
					type="sql"
					default="list_default"
					label="MOD_CBLISTMODULE_FIELD_ORDERBY"
					key_field="id"
					value_field="title"
					translate="true"
					query="SELECT 0 AS sort, 'list_default' AS id, 'MOD_CBLISTMODULE_LIST_DEFAULT' AS title UNION SELECT 1 AS sort, name AS id, name AS title FROM #__comprofiler_fields WHERE published = 1 AND tablecolumns &lt;&gt; '' ORDER BY sort, title ASC"
				/>
				<field
					name="sortorder"
					type="list"
					default="list_default"
					label="MOD_CBLISTMODULE_FIELD_SORTORDER"
					validate="options"
				>
					<option value="list_default">MOD_CBLISTMODULE_LIST_DEFAULT</option>
					<option value="asc">MOD_CBLISTMODULE_ASCENDING</option>
					<option value="desc">MOD_CBLISTMODULE_DESCENDING</option>
					<option value="random">MOD_CBLISTMODULE_RANDOM</option>
				</field>
				<field
					name="text-above"
					type="editor"
					label="MOD_CBLISTMODULE_FIELD_TEXTABOVE"
					buttons="false"
					filter="raw"
				/>
				<field
					name="columns"
					type="list"
					default="0"
					label="MOD_CBLISTMODULE_FIELD_COLUMNS"
					validate="options"
				>
					<option value="0">MOD_CBLISTMODULE_COLUMNS_AUTO</option>
					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
					<option value="6">6</option>
					<option value="7">7</option>
					<option value="8">8</option>
					<option value="9">9</option>
					<option value="10">10</option>
				</field>
				<field
					name="Minwidth"
					type="number"
					min="1"
					filter="integer"
					default="5"
					label="MOD_CBLISTMODULE_FIELD_MINWIDTH"
				/>
				<field
					name="template"
					type="editor"
					label="MOD_CBLISTMODULE_FIELD_TEMPLATE"
					buttons="false"
					default="&lt;div class=&quot;yourclasstostyle&quot;&gt;[show_avatar]&lt;/div&gt;&lt;div class=&quot;yourclasstostyle&quot;&gt;[Linked_name]&lt;/div&gt;"
					filter="raw"
				/>
				<field
					name="rules"
					type="subform"
					default='{&quot;rules0&quot;:{&quot;tag_name&quot;:&quot;avatar&quot;,&quot;htmlcode&quot;:&quot;[avatar]&quot;,&quot;htmlcode_no&quot;:&quot;components\/com_comprofiler\/plugin\/templates\/default\/images\/avatar\/tnnophoto_n.png&quot;},&quot;rules1&quot;:{&quot;tag_name&quot;:&quot;show_avatar&quot;,&quot;htmlcode&quot;:&quot;&lt;a href=\&quot;cb-profile\/[user_id]\&quot;&gt;&lt;img src=\&quot;[avatar]\&quot; alt=\&quot;[name]\&quot; title=\&quot;[name]\&quot; width=\&quot;80\&quot; height=\&quot;80\&quot; \/&gt;&lt;\/a&gt;&quot;,&quot;htmlcode_no&quot;:&quot;Not used with a custom tag name&quot;},&quot;rules2&quot;:{&quot;tag_name&quot;:&quot;canvas&quot;,&quot;htmlcode&quot;:&quot;&lt;img src=\&quot;[canvas]\&quot; width=\&quot;100\&quot; height=\&quot;60\&quot; \/&gt;&quot;,&quot;htmlcode_no&quot;:&quot;There is no canvas image&quot;},&quot;rules3&quot;:{&quot;tag_name&quot;:&quot;Linked_name&quot;,&quot;htmlcode&quot;:&quot;&lt;a href=\&quot;cb-profile\/[user_id]\&quot;&gt;[name]&lt;\/a&gt;&quot;,&quot;htmlcode_no&quot;:&quot;Not used with a custom tag name&quot;}}'
					label="MOD_CBLISTMODULE_FIELD_RULES"
					description="MOD_CBLISTMODULE_FIELD_RULES_DESC"
					multiple="true"
					min="0"
					max="10"
				>
					<form>
						<field
							name="tag_name"
							type="text"
							default=""
							label="MOD_CBLISTMODULE_FIELD_TAGNAME"
						/>
						<field
							name="accesslevel"
							type="accesslevel"
							label="MOD_CBLISTMODULE_FIELD_ACCESSLEVEL"
							description="MOD_CBLISTMODULE_FIELD_ACCESSLEVEL_DESC"
							default="1"
							multiple="true"
						/>
						<field
							name="htmlcode"
							type="textarea"
							default=""
							label="MOD_CBLISTMODULE_FIELD_HTMLCODE"
							description="MOD_CBLISTMODULE_FIELD_HTMLCODE_DESC"
							filter="raw"
							cols="20"
							rows="4"
						/>
						<field
							name="htmlcode_no"
							type="textarea"
							default=""
							label="MOD_CBLISTMODULE_FIELD_HTMLCODENO"
							description="MOD_CBLISTMODULE_FIELD_HTMLCODENO_DESC"
							filter="raw"
							cols="20"
							rows="4"
						/>
					</form>
				</field>
				<field
					name="text-below"
					type="editor"
					label="MOD_CBLISTMODULE_FIELD_TEXTBELOW"
					buttons="false"
					filter="raw"
				/>
				<field
					name="debug"
					type="radio"
					layout="joomla.form.field.radio.switcher"
					default="0"
					label="MOD_CBLISTMODULE_FIELD_DEBUG"
					description="MOD_CBLISTMODULE_FIELD_DEBUG_DESC"
				>
					<option value="0">JOFF</option>
					<option value="1">JON</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field
					name="layout"
					type="modulelayout"
					label="JFIELD_ALT_LAYOUT_LABEL"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
