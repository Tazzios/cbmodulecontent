<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
	<name>PLG_CONTENT_CBPROFILE</name>
	<author>Tazzios</author>
	<authorUrl>https://github.com/Tazzios</authorUrl>
	<creationDate>November 2026</creationDate>
	<copyright>(C) 2022 Tazzios</copyright>
	<license>GNU General Public License version 2 or later</license>
	<version>5.0.1</version>
	<description>PLG_CONTENT_CBPROFILE_XML_DESCRIPTION</description>
	<namespace path="src">Tazzios\Plugin\Content\Cbprofile</namespace>
	<files>
		<folder plugin="cbprofile">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>

	<config>
		<fields name="params">
			<fieldset name="basic">
				<field
					name="imagewidth"
					type="number"
					default="150"
					min="1"
					label="PLG_CONTENT_CBPROFILE_FIELD_IMAGEWIDTH"
				/>
				<field
					name="imageheight"
					type="number"
					default="150"
					min="1"
					label="PLG_CONTENT_CBPROFILE_FIELD_IMAGEHEIGHT"
				/>
				<field
					name="layout"
					type="filelist"
					default="div-default"
					label="PLG_CONTENT_CBPROFILE_FIELD_LAYOUT"
					directory="/plugins/content/cbprofile/tmpl"
					fileFilter="\.php$"
					hide_none="true"
					hide_default="true"
					stripext="true"
				/>
			</fieldset>
		</fields>
	</config>
</extension>
