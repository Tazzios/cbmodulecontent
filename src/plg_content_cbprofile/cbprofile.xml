<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
	<name>Content - cbprofile</name>
	<author>Tazzios</author>
	<creationDate>November 2026</creationDate>
	<copyright></copyright>
	<license>GNU/GPLv3 www.gnu.org/licenses/gpl-3.0.html</license>
	<authorEmail></authorEmail>
	<authorUrl>https://github.com/Tazzios</authorUrl>
	<version>5.0.0</version>
	<description>content plugin for CB profiles</description>
	<files>
		<filename plugin="cbprofile">cbprofile.php</filename>
		<filename>index.html</filename>
		<filename>cbprofile.xml</filename>
		<folder>tmpl</folder>
	</files>

	<config>
		<fields name="params">
			<fieldset name="basic">
			

			<field 
				name="imagewidth" 
				type="int" default="150" 
				label="image width px " 
				description=""
			/>
			<field 
				name="imageheight" 
				type="int" default="150" 
				label="image height px" 
				description=""
			/>
			<field name="layout" type="filelist" default="default" label="Default template" description="" directory="/plugins/content/cbprofile/tmpl" filter=".php" exclude="" stripext="true" />
			<field
				name="escape_values"
				type="radio" default="1"
				label="Escape user data"
				description="Shows HTML in user data as text, so that users can not place scripts with their profile. Only turn off if your own layout needs HTML of a CB field and you trust the users."
			>
				<option value="1">ON</option>
				<option value="0">OFF</option>
			</field>
			
			</fieldset>

			
		</fields>
	</config>
</extension>
